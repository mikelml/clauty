# ClauTY Dashboard — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git

# ── Gateway Connection ──────────────────────────────────────────────────────
# URL base del gateway OpenClaw (default: localhost para dev)
EXPO_PUBLIC_GATEWAY_URL=http://127.0.0.1:18789

# URL de producción (se usa automáticamente en builds no-locales)
EXPO_PUBLIC_GATEWAY_URL_PROD=https://tu-gateway.ejemplo.com

# Auth token para el plugin (debe coincidir con el plugin)
EXPO_PUBLIC_AUTH_TOKEN=<TU_TOKEN_DEL_GATEWAY>

# ── Polling & Reconnect ────────────────────────────────────────────────────
# Intervalo de polling cuando SSE no disponible (ms, default: 5000)
EXPO_PUBLIC_POLL_INTERVAL_MS=5000

# Base para backoff exponencial de reconexión SSE (ms, default: 1000)
EXPO_PUBLIC_RECONNECT_BASE_MS=1000

# Máximo delay de reconexión SSE (ms, default: 8000)
EXPO_PUBLIC_RECONNECT_MAX_MS=8000

# Reintento de gateway cuando en modo mock (ms, default: 30000)
EXPO_PUBLIC_RETRY_MOCK_MS=30000

# ── Timeouts ────────────────────────────────────────────────────────────────
# Timeout default para requests HTTP (ms, default: 8000)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=8000

# Timeout para chat — debe ser mayor que LLM_TIMEOUT_MS del plugin (ms, default: 35000)
EXPO_PUBLIC_CHAT_TIMEOUT_MS=35000
